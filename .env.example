# Copie para .env e ajuste antes de instalar.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loja-exemplo
DB_USER=loja-exemplo
DB_PASSWORD=troque-esta-senha-local
DB_SSLMODE=disable
PORT=3001

# Usado apenas na criação do primeiro administrador (npm run setup).
ADMIN_FULLNAME="Loja Exemplo"
ADMIN_EMAIL="admin@lojaexemplo.com.br"
ADMIN_PASSWORD="troque-esta-senha-local"

# Empresa ativa: o gerador lê companies/<COMPANY_SLUG>.json.
COMPANY_SLUG=loja-exemplo

# URL pública canônica. Use a mesma do manifesto da empresa ativa.
# Não definir HOME_URL: EVERSHOP_HOME_URL é a fonte única do domínio.
# Para desenvolvimento local, ajuste para http://localhost:3001.
EVERSHOP_HOME_URL="https://lojaexemplo.com.br"

# Integrações de marketplace (Fase 3): apenas nomes de variáveis.
# Nunca preencher valores reais neste arquivo; use o cofre/.env da instalação.

# Chave AES-256-GCM: base64 de 32 bytes, exclusiva por instalação.
MARKETPLACE_TOKEN_ENCRYPTION_KEY=

# Mercado Livre: identificação e segredo do aplicativo da empresa.
ML_APP_ID=
ML_CLIENT_SECRET=

# URI de retorno OAuth do Mercado Livre, HTTPS e cadastrada exatamente no DevCenter.
# Exemplo: https://<dominio>/api/marketplaces/mercadolivre/oauth/callback
ML_REDIRECT_URI=

# Segredo para validar as notificações do Mercado Livre.
ML_WEBHOOK_SECRET=

# Shopee BR: identificação e chave do parceiro da empresa.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# URI de retorno OAuth da Shopee, HTTPS e cadastrada exatamente na Open Platform.
# Exemplo: https://<dominio>/api/marketplaces/shopee/oauth/callback
SHOPEE_REDIRECT_URI=

# Segredo para validar as notificações da Shopee.
SHOPEE_WEBHOOK_SECRET=

# Ambiente da Shopee: production ou sandbox (definido na instalação).
SHOPEE_ENV=
